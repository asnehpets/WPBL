  el.innerHTML=`

    &lt;h1&gt;More&lt;/h1&gt;

    &lt;div class="grid grid2"&gt;

      &lt;button
        class="card"
        onclick="go('board')"
        style="text-align:left"
      &gt;
        &lt;h3&gt;💬 Message Board&lt;/h3&gt;
