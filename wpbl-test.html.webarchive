^WebResourceURL_WebResourceTextEncodingName_WebResourceData_WebResourceMIMEType_WebResourceFrameName_phttps://raw.githubusercontent.com/asnehpets/GLOAT-League/71962caaad9105f80a1bb71692b06c5000658270/wpbl-test.htmlUUTF-8O�+<html><head><meta name="color-scheme" content="light dark"></head><body><pre style="word-wrap: break-word; white-space: pre-wrap;">&lt;!doctype html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
&lt;meta charset="utf-8"&gt;
&lt;meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"&gt;
&lt;meta name="theme-color" content="#0d2a4f"&gt;
&lt;title&gt;WPBL — Wall Pickleball League&lt;/title&gt;

&lt;style&gt;
:root{
  --navy:#0d2a4f;
  --blue:#1459a6;
  --red:#d8242f;
  --bg:#f4f7fb;
  --card:#fff;
  --text:#172033;
  --muted:#6b7485;
  --line:#dfe5ee;
  --ok:#147d4b;
  --warn:#a35a00
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);
  color:var(--text)
}
button,input,select,textarea{font:inherit}
.hidden{display:none!important}

.app{min-height:100vh}
.topbar{
  position:sticky;
  top:0;
  z-index:20;
  background:var(--navy);
  color:#fff;
  padding:10px 14px;
  display:flex;
  align-items:center;
  gap:12px;
  box-shadow:0 2px 12px #0002
}
.logo{
  width:54px;
  height:36px;
  object-fit:contain;
  border-radius:6px
}
.brand{
  display:flex;
  align-items:center;
  gap:10px;
  flex:1
}
.brand strong{font-size:19px}
.brand small{display:block;opacity:.8}

.top-actions{display:flex;gap:8px}
.iconbtn{
  background:#ffffff18;
  border:1px solid #ffffff33;
  color:#fff;
  border-radius:10px;
  padding:9px 11px
}

.control{
  background:#fff;
  border-bottom:1px solid var(--line);
  padding:10px 14px;
  display:flex;
  gap:10px;
  align-items:center;
  overflow:auto;
  position:sticky;
  top:57px;
  z-index:15
}
.control label{
  font-size:12px;
  color:var(--muted)
}

select,input,textarea{
  border:1px solid var(--line);
  border-radius:10px;
  padding:9px;
  background:#fff;
  color:var(--text)
}
select{min-width:130px}

.main{
  max-width:980px;
  margin:0 auto;
  padding:16px 14px 88px
}

.nav{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  background:#fff;
  border-top:1px solid var(--line);
  display:grid;
  grid-template-columns:repeat(5,1fr);
  z-index:30;
  padding-bottom:env(safe-area-inset-bottom)
}
.nav button{
  border:0;
  background:#fff;
  padding:10px 4px 8px;
  color:#657087;
  font-size:11px
}
.nav button.active{
  color:var(--blue);
  font-weight:700
}
.nav span{
  display:block;
  font-size:20px;
  margin-bottom:2px
}

h1{font-size:25px;margin:2px 0 4px}
h2{font-size:19px;margin:0 0 12px}
h3{font-size:16px;margin:0 0 10px}
.sub{color:var(--muted);margin:0 0 16px}

.grid{display:grid;gap:12px}
.grid2{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid3{grid-template-columns:repeat(3,minmax(0,1fr))}
@media(max-width:680px){
  .grid2,.grid3{grid-template-columns:1fr}
}

.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:15px;
  box-shadow:0 3px 14px #17315a0a;
  margin-bottom:12px
}
.hero{
  background:linear-gradient(135deg,var(--navy),#173e72);
  color:#fff;
  border:0
}
.hero .sub{color:#dce8fa}

.btn{
  border:0;
  border-radius:11px;
  padding:10px 13px;
  font-weight:700;
  background:var(--blue);
  color:#fff
}
.btn.red{background:var(--red)}
.btn.ghost{background:#eef3f9;color:var(--navy)}
.btn.ok{background:var(--ok)}
.btn.sm{padding:7px 9px;font-size:13px}

.row{
  display:flex;
  gap:8px;
  align-items:center;
  flex-wrap:wrap
}
.row.between{justify-content:space-between}
.stack{display:flex;flex-direction:column;gap:9px}

.badge{
  display:inline-block;
  border-radius:999px;
  padding:5px 9px;
  font-size:12px;
  font-weight:700;
  background:#eaf1fb;
  color:var(--blue)
}
.badge.red{background:#fdecef;color:var(--red)}
.badge.ok{background:#e9f7f0;color:var(--ok)}
.badge.warn{background:#fff2df;color:var(--warn)}

.item{
  border:1px solid var(--line);
  border-radius:12px;
  padding:11px;
  background:#fff
}
.muted{color:var(--muted)}
.tiny{font-size:12px}
.right{text-align:right}

table{
  width:100%;
  border-collapse:collapse;
  font-size:14px
}
th,td{
  padding:9px 7px;
  border-bottom:1px solid var(--line);
  text-align:left
}
th{
  color:var(--muted);
  font-size:12px
}
.tablewrap{overflow:auto}

.game{border-left:5px solid var(--blue)}
.game.current{
  border-left-color:var(--red);
  box-shadow:0 0 0 2px #d8242f18
}
.game.done{opacity:.72}
.game.pending{border-left-color:#e1a100}

.scoreline{font-size:22px;font-weight:800}
.vs{
  font-size:12px;
  color:var(--muted);
  font-weight:700
}

.tabs{
  display:flex;
  gap:6px;
  overflow:auto;
  margin:0 0 12px
}
.tabs button{
  white-space:nowrap;
  border:1px solid var(--line);
  border-radius:999px;
  background:#fff;
  padding:7px 11px
}
.tabs button.active{
  background:var(--navy);
  color:#fff
}

.modalback{
  position:fixed;
  inset:0;
  background:#06152bcc;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  z-index:80
}
.modal{
  width:min(680px,100%);
  max-height:92vh;
  overflow:auto;
  background:#fff;
  border-radius:20px 20px 0 0;
  padding:18px
}

.auth{
  min-height:100vh;
  background:linear-gradient(135deg,#0d2a4f,#164e8d);
  display:grid;
  place-items:center;
  padding:20px
}
.authbox{
  background:#fff;
  width:min(440px,100%);
  border-radius:20px;
  padding:22px;
  text-align:center
}
.authlogo{
  width:180px;
  max-height:120px;
  object-fit:contain
}

.notice{
  padding:10px 12px;
  border-radius:10px;
  background:#eef5ff;
  color:#174d85;
  font-size:13px
}
.notice.warn{
  background:#fff3df;
  color:#8a4e00
}
.notice.ok{
  background:#eaf8f0;
  color:#17623e
}

textarea{
  width:100%;
  min-height:90px;
  resize:vertical
}
.field{
  display:flex;
  flex-direction:column;
  gap:5px
}
.field label{
  font-size:12px;
  color:var(--muted);
  font-weight:600
}
.field input,.field select{width:100%}

.pollopt{
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px;
  border:1px solid var(--line);
  border-radius:10px
}
.thread-title{font-weight:800}
.comment{
  padding:8px 0;
  border-top:1px solid var(--line)
}

.bracket{
  display:grid;
  gap:10px
}
.matchup{
  padding:11px;
  border:1px solid var(--line);
  border-radius:12px
}
.seed{
  font-size:11px;
  color:var(--muted);
  margin-right:4px
}

hr{
  border:0;
  border-top:1px solid var(--line);
  margin:14px 0
}
.danger{color:var(--red)}
&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;div id="root"&gt;&lt;/div&gt;

&lt;script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"&gt;&lt;/script&gt;

&lt;script&gt;
const SUPABASE_URL="https://trujrwhkkjepyorpvjjr.supabase.co";
const SUPABASE_KEY="sb_publishable_RcP9-stV689diug__RIZkg_g5agpSNR";

const sb=window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const LOGO="https://asnehpets.github.io/GLOAT-League/wpbl-logo.png";

const KEY="wpbl_state_secure_v3";

const $=s=&gt;document.querySelector(s);
const $$=s=&gt;[...document.querySelectorAll(s)];

const uid=(p="id")=&gt;
  p+"_"+Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4);

const esc=s=&gt;
  String(s??"").replace(/[&amp;&lt;&gt;"']/g,m=&gt;({
    "&amp;":"&amp;amp;",
    "&lt;":"&amp;lt;",
    "&gt;":"&amp;gt;",
    '"':"&amp;quot;",
    "'":"&amp;#39;"
  }[m]));

const fmtTime=d=&gt;
  new Date(d).toLocaleTimeString([],{
    hour:"numeric",
    minute:"2-digit"
  });

const fmtDate=d=&gt;
  new Date(d+"T12:00:00").toLocaleDateString([],{
    month:"short",
    day:"numeric",
    year:"numeric"
  });

const addMin=(d,m)=&gt;
  new Date(new Date(d).getTime()+m*60000).toISOString();

const today=()=&gt;new Date().toISOString().slice(0,10);

function fresh(adminId,adminName,adminEmail){
  const admin={
    id:adminId,
    name:adminName||"Stephen",
    email:adminEmail||"",
    role:"admin",
    active:true,
    sub:false
  };

  const season={
    id:"s1",
    name:"Fall 2026",
    format:"individual",
    status:"active",
    gameDay:today(),
    startTime:"18:00",
    gamesPerPair:2,
    target:11,
    winBy:2,
    bestOf:1,
    rsvpDays:2,
    playoffs:true,
    playoffQualifiers:4,
    players:[admin.id],
    weeks:[]
  };

  return{
    version:3,
    players:[admin],
    seasons:[season],
    activeSeason:"s1",
    board:[],
    audit:[],
    settings:{
      gameMinutes:18,
      globalBoard:true
    }
  };
}

let state=null;
let currentView="home";
let session="";
let authSession=null;

function load(){
  try{
    const x=localStorage.getItem(KEY);
    return x?JSON.parse(x):null;
  }catch(e){
    return null;
  }
}

function save(){
  localStorage.setItem(KEY,JSON.stringify(state));
}

function me(){
  return state?.players?.find(p=&gt;p.id===session);
}

function season(){
  return state?.seasons?.find(s=&gt;s.id===state.activeSeason)
    ||state?.seasons?.[0];
}

function week(){
  const s=season();
  if(!s)return null;

  return s.weeks.find(w=&gt;w.id===s.activeWeek)
    ||s.weeks.at(-1)
    ||null;
}

function player(id){
  return state.players.find(p=&gt;p.id===id);
}

function pname(id){
  return player(id)?.name||"Unknown";
}

function isAdmin(){
  return me()?.role==="admin";
}

function log(action){
  state.audit.unshift({
    at:new Date().toISOString(),
    by:me()?.name||"System",
    action
  });

  state.audit=state.audit.slice(0,100);
  save();
}

function toast(msg){
  const el=$("#toast");

  if(!el){
    alert(msg);
    return;
  }

  el.textContent=msg;
  el.style.opacity=1;

  setTimeout(()=&gt;{
    el.style.opacity=0;
  },1800);
}

function deadlineFor(s,w){
  const d=new Date(
    (w.date||s.gameDay)+"T"+(s.startTime||"18:00")
  );

  d.setDate(
    d.getDate()-(s.rsvpDays||2)
  );

  return d;
}

function isLocked(s,w){
  return new Date()&gt;deadlineFor(s,w)
    &amp;&amp;!w.rsvpReopened;
}

async function boot(){
  try{
    const {
      data:{session:s}
    }=await sb.auth.getSession();

    authSession=s;
    session=s?.user?.id||"";

    if(!session){
      renderAuth();
      return;
    }

    const {
      data:profile,
      error
    }=await sb
      .from("profiles")
      .select("*")
      .eq("id",session)
      .single();

    if(error){
      document.getElementById("root").innerHTML=`
        &lt;div class="auth"&gt;
          &lt;div class="authbox"&gt;
            &lt;img class="authlogo" src="${LOGO}"&gt;
            &lt;h1&gt;WPBL&lt;/h1&gt;
            &lt;p&gt;${esc(error.message)}&lt;/p&gt;
            &lt;button class="btn" onclick="logout()"&gt;Sign out&lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      `;
      return;
    }

    state=load();

    if(!state){
      state=fresh(
        session,
        profile.name||"Stephen",
        profile.email||s.user.email||""
      );
      save();
    }

    let current=state.players.find(
      p=&gt;p.id===session
    );

    if(!current){
      state.players.push({
        id:session,
        name:profile.name||"Stephen",
        email:profile.email||s.user.email||"",
        role:profile.role||"member",
        active:true,
        sub:profile.is_substitute||false
      });

      if(
        season()
        &amp;&amp;!season().players.includes(session)
      ){
        season().players.push(session);
      }

      save();
    }else{
      current.name=
        profile.name||current.name;

      current.email=
        profile.email||
        s.user.email||
        current.email;

      current.role=
        profile.role||current.role;

      current.sub=
        profile.is_substitute??
        current.sub;

      save();
    }

    render();

  }catch(err){
    console.error(err);

    document.getElementById("root").innerHTML=`
      &lt;div class="auth"&gt;
        &lt;div class="authbox"&gt;
          &lt;h1&gt;WPBL&lt;/h1&gt;
          &lt;p&gt;Something went wrong loading WPBL.&lt;/p&gt;
          &lt;p class="tiny muted"&gt;${esc(err.message||err)}&lt;/p&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    `;
  }
}

sb.auth.onAuthStateChange(
  async(_event,s)=&gt;{
    authSession=s;
    session=s?.user?.id||"";

    if(session){
      await boot();
    }else{
      renderAuth();
    }
  }
);

async function sendMagicLink(){
  const email=
    $("#loginEmail")
    ?.value
    ?.trim()
    .toLowerCase();

  const msg=$("#authMsg");

  if(!email){
    msg.textContent="Enter your email.";
    return;
  }

  msg.textContent="Sending...";

  const {error}=
    await sb.auth.signInWithOtp({
      email,
      options:{
        shouldCreateUser:false,
        emailRedirectTo:
          "https://asnehpets.github.io/GLOAT-League/wpbl-test.html"
      }
    });

  if(error){
    msg.textContent=error.message;
    return;
  }

  msg.textContent=
    "Check your email for the secure WPBL sign-in link.";
}

async function logout(){
  await sb.auth.signOut();
  session="";
  renderAuth();
}

function renderAuth(){
  document.getElementById("root").innerHTML=`
    &lt;div class="auth"&gt;
      &lt;div class="authbox"&gt;

        &lt;img
          class="authlogo"
          src="${LOGO}"
          alt="WPBL"
        &gt;

        &lt;h1&gt;WPBL&lt;/h1&gt;

        &lt;p class="sub"&gt;
          Wall Pickleball League
        &lt;/p&gt;

        &lt;div class="notice"&gt;
          Invite-only league.
          Sign in with the email address
          invited by the commissioner.
        &lt;/div&gt;

        &lt;br&gt;

        &lt;div class="field"&gt;
          &lt;label&gt;Email&lt;/label&gt;

          &lt;input
            id="loginEmail"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          &gt;
        &lt;/div&gt;

        &lt;br&gt;

        &lt;button
          class="btn"
          style="width:100%"
          onclick="sendMagicLink()"
        &gt;
          Email me a secure sign-in link
        &lt;/button&gt;

        &lt;p
          id="authMsg"
          class="tiny muted"
        &gt;&lt;/p&gt;

      &lt;/div&gt;
    &lt;/div&gt;
  `;
}

function render(){
  if(!session||!me()){
    renderAuth();
    return;
  }

  const s=season();

  document.getElementById("root").innerHTML=`
    &lt;div class="app"&gt;

      &lt;header class="topbar"&gt;

        &lt;div class="brand"&gt;
          &lt;img
            class="logo"
            src="${LOGO}"
            alt="WPBL"
          &gt;

          &lt;div&gt;
            &lt;strong&gt;WPBL&lt;/strong&gt;
            &lt;small&gt;Wall Pickleball League&lt;/small&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        &lt;div class="top-actions"&gt;
          &lt;button
            class="iconbtn"
            onclick="go('board')"
          &gt;💬&lt;/button&gt;

          &lt;button
            class="iconbtn"
            onclick="go('profile')"
          &gt;👤&lt;/button&gt;
        &lt;/div&gt;

      &lt;/header&gt;

      &lt;div class="control"&gt;

        &lt;label&gt;
          League / Season&lt;br&gt;

          &lt;select id="seasonSel"&gt;
            ${state.seasons.map(x=&gt;`
              &lt;option
                value="${x.id}"
                ${x.id===state.activeSeason?"selected":""}
              &gt;
                ${esc(x.name)}
              &lt;/option&gt;
            `).join("")}
          &lt;/select&gt;
        &lt;/label&gt;

        ${
          s
          ?`
            &lt;span class="badge ${s.format==="individual"?"":"red"}"&gt;
              ${
                s.format==="individual"
                ?"Rotating Partners"
                :"Fixed Teams"
              }
            &lt;/span&gt;
          `
          :""
        }

      &lt;/div&gt;

      &lt;main
        id="main"
        class="main"
      &gt;&lt;/main&gt;

      &lt;nav class="nav"&gt;

        ${navbtn("home","⌂","Home")}
        ${navbtn("schedule","▣","Schedule")}
        ${navbtn("live","▶","Live")}
        ${navbtn("standings","★","Standings")}
        ${navbtn("more","☰","More")}

      &lt;/nav&gt;

      &lt;div id="modalRoot"&gt;&lt;/div&gt;

      &lt;div
        id="toast"
        style="
          position:fixed;
          left:50%;
          bottom:80px;
          transform:translateX(-50%);
          background:#172033;
          color:#fff;
          padding:9px 13px;
          border-radius:999px;
          z-index:100;
          opacity:0;
          transition:.2s
        "
      &gt;&lt;/div&gt;

    &lt;/div&gt;
  `;

  $("#seasonSel").onchange=e=&gt;{
    state.activeSeason=e.target.value;
    save();
    render();
  };

  renderView();
}

function navbtn(v,i,l){
  return`
    &lt;button
      onclick="go('${v}')"
      class="${currentView===v?"active":""}"
    &gt;
      &lt;span&gt;${i}&lt;/span&gt;
      ${l}
    &lt;/button&gt;
  `;
}

function go(v){
  currentView=v;
  renderView();

  $$(".nav button").forEach(b=&gt;{
    b.classList.toggle(
      "active",
      b.getAttribute("onclick")
        ?.includes(`'${v}'`)
    );
  });
}

function renderView(){
  const el=$("#main");
  if(!el)return;

  const views={
    home:homeView,
    schedule:scheduleView,
    live:liveView,
    standings:standingsView,
    board:boardView,
    more:moreView,
    profile:profileView,
    admin:adminView,
    playoffs:playoffsView
  };

  const fn=
    views[currentView]
    ||homeView;

  fn(el);
}

function homeView(el){
  const s=season();
  const w=week();

  const mine=
    w?.availability?.[me().id];

  const cur=
    w?.games?.find(
      g=&gt;g.status!=="confirmed"
    );

  el.innerHTML=`

    &lt;h1&gt;${esc(s?.name||"WPBL")}&lt;/h1&gt;

    &lt;p class="sub"&gt;
      ${
        s?.format==="individual"
        ?"Individual standings • weekly rotating partners"
        :"Fixed-team league"
      }
    &lt;/p&gt;

    &lt;div class="card hero"&gt;

      &lt;h2&gt;
        ${
          w
          ?`Week ${w.number} — ${fmtDate(w.date)}`
          :"Season ready"
        }
      &lt;/h2&gt;

      &lt;p class="sub"&gt;
        ${
          w
          ?`RSVP deadline: ${
              deadlineFor(s,w)
              .toLocaleString([],{
                month:"short",
                day:"numeric",
                hour:"numeric",
                minute:"2-digit"
              })
            }`
          :"Admin can create the first week when ready."
        }
      &lt;/p&gt;

      ${
        w
        ?`
          &lt;div class="row"&gt;

            &lt;button
              class="btn ${mine==="in"?"ok":"ghost"}"
              onclick="rsvp('in')"
            &gt;
              ✓ Playing
            &lt;/button&gt;

            &lt;button
              class="btn ${mine==="out"?"red":"ghost"}"
              onclick="rsvp('out')"
            &gt;
              ✕ Not Playing
            &lt;/button&gt;

          &lt;/div&gt;
        `
        :""
      }

    &lt;/div&gt;

    ${
      cur
      ?`
        &lt;div class="card"&gt;

          &lt;div class="row between"&gt;
            &lt;h2&gt;Current / Next Game&lt;/h2&gt;

            &lt;span class="badge red"&gt;
              ${
                cur.status==="pending"
                ?"Awaiting confirmation"
                :"Up next"
              }
            &lt;/span&gt;
          &lt;/div&gt;

          ${gameSummary(cur,w)}

          &lt;button
            class="btn"
            onclick="go('live')"
          &gt;
            Open Live Game
          &lt;/button&gt;

        &lt;/div&gt;
      `
      :""
    }

    &lt;div class="grid grid2"&gt;

      &lt;div class="card"&gt;

        &lt;h3&gt;Standings&lt;/h3&gt;

        ${topStandings(4)}

        &lt;button
          class="btn ghost sm"
          onclick="go('standings')"
        &gt;
          Full standings
        &lt;/button&gt;

      &lt;/div&gt;

      &lt;div class="card"&gt;

        &lt;h3&gt;League Board&lt;/h3&gt;

        ${
          state.board.length
          ?state.board
            .slice(0,3)
            .map(t=&gt;`
              &lt;div class="item"&gt;
                &lt;b&gt;${esc(t.title)}&lt;/b&gt;
                &lt;div class="tiny muted"&gt;
                  ${t.comments.length} comments
                &lt;/div&gt;
              &lt;/div&gt;
            `).join("")
          :`&lt;p class="muted"&gt;No posts yet.&lt;/p&gt;`
        }

        &lt;button
          class="btn ghost sm"
          onclick="go('board')"
        &gt;
          Open message board
        &lt;/button&gt;

      &lt;/div&gt;

    &lt;/div&gt;
  `;
}

function rsvp(v){
  const s=season();
  const w=week();

  if(!w)return;

  if(isLocked(s,w)&amp;&amp;!isAdmin()){
    toast("RSVP is locked");
    return;
  }

  w.availability=
    w.availability||{};

  w.availability[me().id]=v;

  save();
  renderView();
}

function gameSummary(g,w){
  return`
    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;b&gt;
          ${g.teamA.map(pname).join(" &amp; ")}
        &lt;/b&gt;

        &lt;div class="vs"&gt;
          VS
        &lt;/div&gt;

        &lt;b&gt;
          ${g.teamB.map(pname).join(" &amp; ")}
        &lt;/b&gt;

      &lt;/div&gt;

      &lt;div class="right"&gt;

        &lt;div class="tiny muted"&gt;
          ${
            g.estimate
            ?fmtTime(g.estimate)
            :""
          }
        &lt;/div&gt;

        ${
          g.score
          ?`
            &lt;div class="scoreline"&gt;
              ${g.score.a}–${g.score.b}
            &lt;/div&gt;
          `
          :""
        }

      &lt;/div&gt;

    &lt;/div&gt;
  `;
}

function scheduleView(el){
  const s=season();
  const w=week();

  el.innerHTML=`

    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;h1&gt;Schedule&lt;/h1&gt;

        &lt;p class="sub"&gt;
          ${
            w
            ?`Week ${w.number} • ${fmtDate(w.date)}`
            :"No week created"
          }
        &lt;/p&gt;

      &lt;/div&gt;

      ${
        isAdmin()
        ?`
          &lt;button
            class="btn"
            onclick="openWeekSetup()"
          &gt;
            Week Setup
          &lt;/button&gt;
        `
        :""
      }

    &lt;/div&gt;

    ${
      !w
      ?`
        &lt;div class="card"&gt;
          &lt;p&gt;No weekly schedule yet.&lt;/p&gt;
        &lt;/div&gt;
      `
      :`

        &lt;div class="card"&gt;

          &lt;div class="row between"&gt;

            &lt;div&gt;

              &lt;b&gt;RSVP&lt;/b&gt;

              &lt;div class="tiny muted"&gt;
                ${
                  isLocked(s,w)
                  ?"Locked"
                  :"Open"
                }
                until
                ${deadlineFor(s,w).toLocaleString()}
              &lt;/div&gt;

            &lt;/div&gt;

            ${
              isAdmin()
              ?`
                &lt;button
                  class="btn ghost sm"
                  onclick="toggleRsvp()"
                &gt;
                  ${
                    w.rsvpReopened
                    ?"Relock"
                    :"Reopen RSVP"
                  }
                &lt;/button&gt;
              `
              :""
            }

          &lt;/div&gt;

          &lt;hr&gt;

          ${
            s.players.map(id=&gt;`
              &lt;span
                class="badge ${
                  (w.availability||{})[id]==="out"
                  ?"red"
                  :(w.availability||{})[id]==="in"
                  ?"ok"
                  :""
                }"
              &gt;
                ${esc(pname(id))}:
                ${
                  (w.availability||{})[id]==="in"
                  ?"Playing"
                  :(w.availability||{})[id]==="out"
                  ?"Out"
                  :"No response"
                }
              &lt;/span&gt;
            `).join("")
          }

        &lt;/div&gt;

        &lt;div class="card"&gt;

          &lt;div class="row between"&gt;

            &lt;h2&gt;Game Order&lt;/h2&gt;

            ${
              isAdmin()
              ?`
                &lt;button
                  class="btn ghost sm"
                  onclick="generateSchedule()"
                &gt;
                  Generate / Regenerate
                &lt;/button&gt;
              `
              :""
            }

          &lt;/div&gt;

          ${
            (w.games||[]).length
            ?w.games.map((g,i)=&gt;`

              &lt;div
                class="
                  item
                  game
                  ${
                    g.status==="confirmed"
                    ?"done"
                    :g.status==="pending"
                    ?"pending"
                    :i===nextGameIndex(w)
                    ?"current"
                    :""
                  }
                "
              &gt;

                &lt;div class="row between"&gt;

                  &lt;b&gt;Game ${i+1}&lt;/b&gt;

                  &lt;span class="tiny muted"&gt;
                    ${
                      g.estimate
                      ?fmtTime(g.estimate)
                      :""
                    }
                  &lt;/span&gt;

                &lt;/div&gt;

                ${gameSummary(g,w)}

                ${
                  isAdmin()
                  ?`
                    &lt;div class="row"&gt;

                      &lt;button
                        class="btn ghost sm"
                        onclick="moveGame(${i},-1)"
                      &gt;
                        ↑
                      &lt;/button&gt;

                      &lt;button
                        class="btn ghost sm"
                        onclick="moveGame(${i},1)"
                      &gt;
                        ↓
                      &lt;/button&gt;

                    &lt;/div&gt;
                  `
                  :""
                }

              &lt;/div&gt;

            `).join("")
            :`&lt;p class="muted"&gt;No games generated yet.&lt;/p&gt;`
          }

        &lt;/div&gt;

      `
    }
  `;
}

function toggleRsvp(){
  const w=week();

  w.rsvpReopened=
    !w.rsvpReopened;

  save();
  renderView();
}

function nextGameIndex(w){
  const i=
    w.games.findIndex(
      g=&gt;g.status!=="confirmed"
    );

  return i&lt;0
    ?w.games.length
    :i;
}

function moveGame(i,d){
  const w=week();
  const j=i+d;

  if(j&lt;0||j&gt;=w.games.length)return;

  [
    w.games[i],
    w.games[j]
  ]=[
    w.games[j],
    w.games[i]
  ];

  recalcTimes(w);

  save();
  renderView();
}

function openWeekSetup(){
  const s=season();

  modal(`

    &lt;h2&gt;Create / Update Week&lt;/h2&gt;

    &lt;div class="grid grid2"&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;Week number&lt;/label&gt;

        &lt;input
          id="wn"
          type="number"
          value="${
            (s.weeks.at(-1)?.number||0)+1
          }"
        &gt;

      &lt;/div&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;Game date&lt;/label&gt;

        &lt;input
          id="wd"
          type="date"
          value="${s.gameDay||today()}"
        &gt;

      &lt;/div&gt;

    &lt;/div&gt;

    &lt;br&gt;

    &lt;button
      class="btn"
      onclick="createWeek()"
    &gt;
      Save Week
    &lt;/button&gt;
  `);
}

function createWeek(){
  const s=season();

  const n=
    +$("#wn").value;

  const d=
    $("#wd").value;

  let w=
    s.weeks.find(x=&gt;x.number===n);

  if(!w){
    w={
      id:uid("w"),
      number:n,
      date:d,
      availability:{},
      games:[],
      partners:{},
      rsvpReopened:false
    };

    s.weeks.push(w);
  }else{
    w.date=d;
  }

  s.activeWeek=w.id;
  s.gameDay=d;

  save();
  closeModal();
  renderView();
}

function generateSchedule(){
  const s=season();
  const w=week();

  if(!w)return;

  const ids=
    s.players.filter(
      id=&gt;
        (w.availability||{})[id]!=="out"
        &amp;&amp;player(id)?.active
    );

  if(ids.length&lt;4){
    toast(
      "Need at least 4 available players"
    );
    return;
  }

  let pairings=[];

  if(s.format==="individual"){
    pairings=
      bestPairs(ids,s,w);
  }else{
    const teams=
      (s.teams||[])
      .filter(
        t=&gt;t.every(id=&gt;ids.includes(id))
      );

    if(teams.length&lt;2){
      toast(
        "Set at least 2 available teams in Admin"
      );
      return;
    }

    for(let i=0;i&lt;teams.length;i++){
      for(let j=i+1;j&lt;teams.length;j++){
        pairings.push([
          teams[i],
          teams[j]
        ]);
      }
    }
  }

  let games=[];

  const target=
    Math.max(
      1,
      s.gamesPerPair||1
    );

  if(s.format==="individual"){
    const teams=pairings;
    let all=[];

    for(let i=0;i&lt;teams.length;i++){
      for(let j=i+1;j&lt;teams.length;j++){
        all.push([
          teams[i],
          teams[j]
        ]);
      }
    }

    all=
      sortOpponentVariety(
        all,
        s
      );

    for(let k=0;k&lt;target;k++){
      games.push(...all);
    }
  }else{
    for(let k=0;k&lt;target;k++){
      games.push(...pairings);
    }
  }

  games=
    orderForRest(games);

  w.games=
    games.map(x=&gt;({
      id:uid("g"),
      teamA:x[0],
      teamB:x[1],
      status:"scheduled",
      score:null,
      submittedBy:null,
      confirmedBy:null,
      estimate:null
    }));

  w.partners={};

  if(s.format==="individual"){
    pairings.forEach(t=&gt;{
      t.forEach(id=&gt;{
        w.partners[id]=
          t.filter(x=&gt;x!==id);
      });
    });
  }

  recalcTimes(w);

  save();

  log(
    `Generated Week ${w.number} schedule`
  );

  renderView();

  toast("Schedule generated");
}

function pairHistory(s,a,b){
  let c=0;

  s.weeks.forEach(w=&gt;{
    const p=w.partners||{};

    if(
      (p[a]||[]).includes(b)
    ){
      c++;
    }
  });

  return c;
}

function bestPairs(ids,s,w){
  let remaining=[...ids];
  const teams=[];

  while(remaining.length&gt;=2){

    const a=
      remaining.shift();

    const choices=
      remaining
      .map(b=&gt;({
        b,
        c:pairHistory(s,a,b),
        r:Math.random()
      }))
      .sort(
        (x,y)=&gt;
          x.c-y.c
          ||x.r-y.r
      );

    const b=
      choices[0].b;

    remaining=
      remaining.filter(x=&gt;x!==b);

    teams.push([a,b]);
  }

  return teams;
}

function oppCount(s,t1,t2){
  const set1=
    new Set(t1);

  const set2=
    new Set(t2);

  let c=0;

  s.weeks.forEach(w=&gt;
    (w.games||[])
    .filter(
      g=&gt;g.status==="confirmed"
    )
    .forEach(g=&gt;{

      const A=
        new Set(g.teamA);

      const B=
        new Set(g.teamB);

      if(
        (
          [...set1].some(x=&gt;A.has(x))
          &amp;&amp;
          [...set2].some(x=&gt;B.has(x))
        )
        ||
        (
          [...set1].some(x=&gt;B.has(x))
          &amp;&amp;
          [...set2].some(x=&gt;A.has(x))
        )
      ){
        c++;
      }
    })
  );

  return c;
}

function sortOpponentVariety(all,s){
  return all
    .map(x=&gt;({
      x,
      c:oppCount(s,x[0],x[1]),
      r:Math.random()
    }))
    .sort(
      (a,b)=&gt;
        a.c-b.c
        ||a.r-b.r
    )
    .map(z=&gt;z.x);
}

function orderForRest(games){
  let rem=[...games];
  const out=[];
  let lastPlayers=new Set();

  while(rem.length){

    let idx=
      rem.findIndex(
        x=&gt;
          ![
            ...x[0],
            ...x[1]
          ].some(
            p=&gt;lastPlayers.has(p)
          )
      );

    if(idx&lt;0){
      idx=0;
    }

    const g=
      rem.splice(idx,1)[0];

    out.push(g);

    lastPlayers=
      new Set([
        ...g[0],
        ...g[1]
      ]);
  }

  return out;
}

function recalcTimes(w){
  const s=season();

  const start=
    new Date(
      `${w.date}T${s.startTime||"18:00"}`
    );

  (w.games||[])
  .forEach((g,i)=&gt;{
    g.estimate=
      addMin(
        start,
        i*(state.settings.gameMinutes||18)
      );
  });
}

function liveView(el){
  const w=week();

  if(!w){
    el.innerHTML=`
      &lt;h1&gt;Live Games&lt;/h1&gt;
      &lt;div class="card"&gt;
        No week scheduled.
      &lt;/div&gt;
    `;
    return;
  }

  const idx=
    nextGameIndex(w);

  const g=
    w.games[idx];

  const on=
    w.games[idx+1];

  el.innerHTML=`

    &lt;h1&gt;League Night&lt;/h1&gt;

    &lt;p class="sub"&gt;
      One game at a time • scores must
      be confirmed before advancing
    &lt;/p&gt;

    ${
      g
      ?`

        &lt;div class="card game current"&gt;

          &lt;div class="row between"&gt;

            &lt;span class="badge red"&gt;
              CURRENT GAME ${idx+1}
            &lt;/span&gt;

            &lt;b&gt;
              ${
                g.estimate
                ?fmtTime(g.estimate)
                :""
              }
            &lt;/b&gt;

          &lt;/div&gt;

          &lt;br&gt;

          ${gameSummary(g,w)}

          ${
            g.status==="scheduled"
            ?scoreEntry(g)
            :pendingConfirm(g)
          }

        &lt;/div&gt;

      `
      :`

        &lt;div class="card"&gt;

          &lt;h2&gt;
            All games complete 🎉
          &lt;/h2&gt;

          &lt;button
            class="btn"
            onclick="go('standings')"
          &gt;
            View standings
          &lt;/button&gt;

        &lt;/div&gt;

      `
    }

    ${
      on
      ?`

        &lt;div class="card"&gt;

          &lt;span class="badge"&gt;
            ON DECK
          &lt;/span&gt;

          &lt;br&gt;&lt;br&gt;

          ${gameSummary(on,w)}

        &lt;/div&gt;

      `
      :""
    }

    &lt;div class="card"&gt;

      &lt;h3&gt;Full Order&lt;/h3&gt;

      ${
        w.games.map((x,i)=&gt;`

          &lt;div class="row between item"&gt;

            &lt;span&gt;
              ${i+1}.
              ${esc(x.teamA.map(pname).join(" / "))}
              vs
              ${esc(x.teamB.map(pname).join(" / "))}
            &lt;/span&gt;

            &lt;span
              class="badge ${
                x.status==="confirmed"
                ?"ok"
                :x.status==="pending"
                ?"warn"
                :""
              }"
            &gt;
              ${x.status}
            &lt;/span&gt;

          &lt;/div&gt;

        `).join("")
      }

    &lt;/div&gt;
  `;
}

function canParticipate(g){
  return[
    ...g.teamA,
    ...g.teamB
  ].includes(me().id);
}

function scoreEntry(g){
  if(
    !canParticipate(g)
    &amp;&amp;!isAdmin()
  ){
    return`
      &lt;p class="notice"&gt;
        Only players in this game
        can enter the score.
      &lt;/p&gt;
    `;
  }

  return`

    &lt;hr&gt;

    &lt;h3&gt;
      Enter final score
    &lt;/h3&gt;

    &lt;div class="row"&gt;

      &lt;input
        id="sa"
        type="number"
        min="0"
        placeholder="${g.teamA.map(pname).join(" &amp; ")}"
      &gt;

      &lt;span&gt;–&lt;/span&gt;

      &lt;input
        id="sb"
        type="number"
        min="0"
        placeholder="${g.teamB.map(pname).join(" &amp; ")}"
      &gt;

      &lt;button
        class="btn"
        onclick="submitScore('${g.id}')"
      &gt;
        Submit
      &lt;/button&gt;

    &lt;/div&gt;
  `;
}

function submitScore(id){
  const w=week();

  const g=
    w.games.find(
      x=&gt;x.id===id
    );

  const a=
    +$("#sa").value;

  const b=
    +$("#sb").value;

  if(
    a===b
    ||a&lt;0
    ||b&lt;0
  ){
    toast(
      "Enter a valid final score"
    );
    return;
  }

  g.score={a,b};
  g.submittedBy=me().id;
  g.status="pending";

  save();
  renderView();
}

function pendingConfirm(g){
  const submitTeam=
    g.teamA.includes(g.submittedBy)
    ?"A"
    :"B";

  const opp=
    submitTeam==="A"
    ?g.teamB
    :g.teamA;

  const allowed=
    opp.includes(me().id)
    ||isAdmin();

  return`

    &lt;hr&gt;

    &lt;div class="notice warn"&gt;

      &lt;b&gt;
        Score awaiting opponent confirmation
      &lt;/b&gt;

      &lt;br&gt;

      ${g.teamA.map(pname).join(" &amp; ")}
      ${g.score.a}
      –
      ${g.score.b}
      ${g.teamB.map(pname).join(" &amp; ")}

    &lt;/div&gt;

    &lt;br&gt;

    ${
      allowed
      ?`

        &lt;div class="row"&gt;

          &lt;button
            class="btn ok"
            onclick="confirmScore('${g.id}')"
          &gt;
            Confirm &amp; Advance
          &lt;/button&gt;

          &lt;button
            class="btn ghost"
            onclick="editPending('${g.id}')"
          &gt;
            Correct Score
          &lt;/button&gt;

        &lt;/div&gt;

      `
      :`

        &lt;p class="tiny muted"&gt;
          A player from the opposing side
          must confirm before the next game begins.
        &lt;/p&gt;

      `
    }
  `;
}

function editPending(id){
  const g=
    week().games.find(
      x=&gt;x.id===id
    );

  g.status="scheduled";
  g.score=null;
  g.submittedBy=null;

  save();
  renderView();
}

function confirmScore(id){
  const w=week();

  const g=
    w.games.find(
      x=&gt;x.id===id
    );

  g.status="confirmed";
  g.confirmedBy=me().id;
  g.completedAt=
    new Date().toISOString();

  recalcTimesFromActual(w);

  save();

  log(
    `Confirmed Week ${w.number} game score`
  );

  renderView();
}

function recalcTimesFromActual(w){
  const idx=
    nextGameIndex(w);

  const base=
    new Date();

  for(
    let i=idx;
    i&lt;w.games.length;
    i++
  ){
    w.games[i].estimate=
      addMin(
        base,
        (i-idx)
        *(state.settings.gameMinutes||18)
      );
  }
}

function standingsData(){
  const s=season();

  const rows={};

  s.players.forEach(id=&gt;{
    rows[id]={
      id,
      w:0,
      l:0,
      gp:0,
      pf:0,
      pa:0,
      pd:0,
      h2h:{}
    };
  });

  s.weeks.forEach(w=&gt;
    (w.games||[])
    .filter(
      g=&gt;g.status==="confirmed"
    )
    .forEach(g=&gt;{

      const aWin=
        g.score.a&gt;g.score.b;

      g.teamA.forEach(id=&gt;{

        if(!rows[id])return;

        rows[id].gp++;
        rows[id].pf+=g.score.a;
        rows[id].pa+=g.score.b;

        if(aWin){
          rows[id].w++;
        }else{
          rows[id].l++;
        }

        g.teamB.forEach(o=&gt;{
          rows[id].h2h[o]=
            (rows[id].h2h[o]||0)
            +(aWin?1:-1);
        });

      });

      g.teamB.forEach(id=&gt;{

        if(!rows[id])return;

        rows[id].gp++;
        rows[id].pf+=g.score.b;
        rows[id].pa+=g.score.a;

        if(aWin){
          rows[id].l++;
        }else{
          rows[id].w++;
        }

        g.teamA.forEach(o=&gt;{
          rows[id].h2h[o]=
            (rows[id].h2h[o]||0)
            +(aWin?-1:1);
        });

      });

    })
  );

  const arr=
    Object.values(rows)
    .map(r=&gt;({
      ...r,
      pct:r.gp
        ?r.w/r.gp
        :0,
      pd:r.pf-r.pa
    }));

  arr.sort(
    (a,b)=&gt;
      b.pct-a.pct
      ||headToHead(a,b)
      ||b.pd-a.pd
      ||b.w-a.w
      ||pname(a.id)
        .localeCompare(pname(b.id))
  );

  return arr;
}

function headToHead(a,b){
  return(
    (b.h2h[a.id]||0)
    -(a.h2h[b.id]||0)
  );
}

function topStandings(n){
  const a=
    standingsData()
    .slice(0,n);

  return a.length
    ?`
      &lt;table&gt;

        &lt;tr&gt;
          &lt;th&gt;#&lt;/th&gt;
          &lt;th&gt;Player&lt;/th&gt;
          &lt;th&gt;W-L&lt;/th&gt;
          &lt;th&gt;Win%&lt;/th&gt;
        &lt;/tr&gt;

        ${
          a.map((r,i)=&gt;`

            &lt;tr&gt;

              &lt;td&gt;${i+1}&lt;/td&gt;

              &lt;td&gt;
                ${esc(pname(r.id))}
              &lt;/td&gt;

              &lt;td&gt;
                ${r.w}-${r.l}
              &lt;/td&gt;

              &lt;td&gt;
                ${(r.pct*100).toFixed(1)}%
              &lt;/td&gt;

            &lt;/tr&gt;

          `).join("")
        }

      &lt;/table&gt;
    `
    :`
      &lt;p class="muted"&gt;
        No results yet.
      &lt;/p&gt;
    `;
}

function standingsView(el){
  const a=
    standingsData();

  el.innerHTML=`

    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;h1&gt;Standings&lt;/h1&gt;

        &lt;p class="sub"&gt;
          Win % → head-to-head →
          point differential
        &lt;/p&gt;

      &lt;/div&gt;

      ${
        season().playoffs
        ?`
          &lt;button
            class="btn"
            onclick="go('playoffs')"
          &gt;
            Playoffs
          &lt;/button&gt;
        `
        :""
      }

    &lt;/div&gt;

    &lt;div class="card tablewrap"&gt;

      &lt;table&gt;

        &lt;tr&gt;
          &lt;th&gt;#&lt;/th&gt;
          &lt;th&gt;Player&lt;/th&gt;
          &lt;th&gt;W-L&lt;/th&gt;
          &lt;th&gt;GP&lt;/th&gt;
          &lt;th&gt;Win %&lt;/th&gt;
          &lt;th&gt;PF&lt;/th&gt;
          &lt;th&gt;PA&lt;/th&gt;
          &lt;th&gt;+/-&lt;/th&gt;
        &lt;/tr&gt;

        ${
          a.map((r,i)=&gt;`

            &lt;tr&gt;

              &lt;td&gt;${i+1}&lt;/td&gt;

              &lt;td&gt;
                &lt;b&gt;${esc(pname(r.id))}&lt;/b&gt;
              &lt;/td&gt;

              &lt;td&gt;
                ${r.w}-${r.l}
              &lt;/td&gt;

              &lt;td&gt;
                ${r.gp}
              &lt;/td&gt;

              &lt;td&gt;
                ${(r.pct*100).toFixed(1)}%
              &lt;/td&gt;

              &lt;td&gt;
                ${r.pf}
              &lt;/td&gt;

              &lt;td&gt;
                ${r.pa}
              &lt;/td&gt;

              &lt;td&gt;
                ${r.pd&gt;0?"+":""}${r.pd}
              &lt;/td&gt;

            &lt;/tr&gt;

          `).join("")
        }

      &lt;/table&gt;

    &lt;/div&gt;
  `;
}

function playoffsView(el){
  const s=season();

  const q=
    Math.min(
      s.playoffQualifiers||4,
      standingsData().length
    );

  const seeds=
    standingsData()
    .slice(0,q);

  const matches=[];

  for(
    let i=0;
    i&lt;Math.floor(q/2);
    i++
  ){
    matches.push([
      seeds[i],
      seeds[q-1-i]
    ]);
  }

  el.innerHTML=`

    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;h1&gt;Playoffs&lt;/h1&gt;

        &lt;p class="sub"&gt;
          Auto-seeded from final standings
        &lt;/p&gt;

      &lt;/div&gt;

      &lt;button
        class="btn ghost"
        onclick="go('standings')"
      &gt;
        Back
      &lt;/button&gt;

    &lt;/div&gt;

    &lt;div class="card"&gt;

      &lt;div class="bracket"&gt;

        ${
          matches.map((m,i)=&gt;`

            &lt;div class="matchup"&gt;

              &lt;b&gt;
                Match ${i+1}
              &lt;/b&gt;

              &lt;div&gt;
                &lt;span class="seed"&gt;
                  #${i+1}
                &lt;/span&gt;

                ${esc(pname(m[0].id))}
              &lt;/div&gt;

              &lt;div&gt;
                &lt;span class="seed"&gt;
                  #${q-i}
                &lt;/span&gt;

                ${esc(pname(m[1].id))}
              &lt;/div&gt;

            &lt;/div&gt;

          `).join("")
          ||`
            &lt;p&gt;
              Not enough players yet.
            &lt;/p&gt;
          `
        }

      &lt;/div&gt;

      ${
        isAdmin()
        ?`
          &lt;p class="tiny muted"&gt;
            Admin seeding override will
            be available in production.
          &lt;/p&gt;
        `
        :""
      }

    &lt;/div&gt;
  `;
}

function boardView(el){
  el.innerHTML=`

    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;h1&gt;WPBL Board&lt;/h1&gt;

        &lt;p class="sub"&gt;
          One global board for
          posts, threads and polls
        &lt;/p&gt;

      &lt;/div&gt;

      &lt;button
        class="btn"
        onclick="newThread()"
      &gt;
        New Post
      &lt;/button&gt;

    &lt;/div&gt;

    ${
      state.board.length
      ?state.board
        .map(t=&gt;threadCard(t))
        .join("")
      :`
        &lt;div class="card"&gt;
          &lt;p&gt;
            No posts yet.
            Start the first thread.
          &lt;/p&gt;
        &lt;/div&gt;
      `
    }
  `;
}

function threadCard(t){
  const votes={};

  (t.poll?.options||[])
  .forEach((o,i)=&gt;{
    votes[i]=
      Object.values(
        t.poll.votes||{}
      )
      .filter(v=&gt;v==i)
      .length;
  });

  return`

    &lt;div class="card"&gt;

      &lt;div class="row between"&gt;

        &lt;div&gt;

          &lt;div class="thread-title"&gt;
            ${esc(t.title)}
          &lt;/div&gt;

          &lt;div class="tiny muted"&gt;
            ${esc(t.author)}
            •
            ${new Date(t.at).toLocaleString()}
          &lt;/div&gt;

        &lt;/div&gt;

        ${
          isAdmin()
          ?`
            &lt;button
              class="btn ghost sm danger"
              onclick="deleteThread('${t.id}')"
            &gt;
              Delete
            &lt;/button&gt;
          `
          :""
        }

      &lt;/div&gt;

      &lt;p&gt;
        ${esc(t.body)}
      &lt;/p&gt;

      ${
        t.poll
        ?`

          &lt;div class="stack"&gt;

            ${
              t.poll.options.map((o,i)=&gt;`

                &lt;button
                  class="pollopt"
                  onclick="vote('${t.id}',${i})"
                &gt;

                  &lt;span&gt;○&lt;/span&gt;

                  &lt;span
                    style="
                      flex:1;
                      text-align:left
                    "
                  &gt;
                    ${esc(o)}
                  &lt;/span&gt;

                  &lt;b&gt;
                    ${votes[i]}
                  &lt;/b&gt;

                &lt;/button&gt;

              `).join("")
            }

          &lt;/div&gt;

        `
        :""
      }

      &lt;div&gt;

        ${
          t.comments.map(c=&gt;`

            &lt;div class="comment"&gt;

              &lt;b&gt;
                ${esc(c.author)}
              &lt;/b&gt;

              &lt;span class="tiny muted"&gt;
                ${new Date(c.at).toLocaleString()}
              &lt;/span&gt;

              &lt;div&gt;
                ${esc(c.body)}
              &lt;/div&gt;

            &lt;/div&gt;

          `).join("")
        }

      &lt;/div&gt;

      &lt;div class="row"&gt;

        &lt;input
          id="c_${t.id}"
          style="flex:1"
          placeholder="Add a comment"
        &gt;

        &lt;button
          class="btn ghost sm"
          onclick="comment('${t.id}')"
        &gt;
          Reply
        &lt;/button&gt;

      &lt;/div&gt;

    &lt;/div&gt;
  `;
}

function newThread(){
  modal(`

    &lt;h2&gt;
      New Board Post
    &lt;/h2&gt;

    &lt;div class="stack"&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;
          Title
        &lt;/label&gt;

        &lt;input id="tt"&gt;

      &lt;/div&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;
          Post
        &lt;/label&gt;

        &lt;textarea id="tb"&gt;&lt;/textarea&gt;

      &lt;/div&gt;

      &lt;label&gt;
        &lt;input
          id="isPoll"
          type="checkbox"
        &gt;
        Add poll
      &lt;/label&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;
          Poll options
          (one per line)
        &lt;/label&gt;

        &lt;textarea
          id="po"
          placeholder="Option 1&amp;#10;Option 2"
        &gt;&lt;/textarea&gt;

      &lt;/div&gt;

      &lt;button
        class="btn"
        onclick="saveThread()"
      &gt;
        Post
      &lt;/button&gt;

    &lt;/div&gt;
  `);
}

function saveThread(){
  const title=
    $("#tt").value.trim();

  const body=
    $("#tb").value.trim();

  if(!title){
    toast("Add a title");
    return;
  }

  const is=
    $("#isPoll").checked;

  const opts=
    $("#po").value
    .split("\n")
    .map(x=&gt;x.trim())
    .filter(Boolean);

  state.board.unshift({
    id:uid("t"),
    title,
    body,
    author:me().name,
    authorId:me().id,
    at:new Date().toISOString(),
    comments:[],
    poll:
      is&amp;&amp;opts.length&gt;=2
      ?{
        options:opts,
        votes:{}
      }
      :null
  });

  save();
  closeModal();
  renderView();
}

function comment(id){
  const t=
    state.board.find(
      x=&gt;x.id===id
    );

  const v=
    $("#c_"+id).value.trim();

  if(!v)return;

  t.comments.push({
    id:uid("c"),
    author:me().name,
    authorId:me().id,
    body:v,
    at:new Date().toISOString()
  });

  save();
  renderView();
}

function vote(id,i){
  const t=
    state.board.find(
      x=&gt;x.id===id
    );

  t.poll.votes[me().id]=i;

  save();
  renderView();
}

function deleteThread(id){
  if(
    !confirm(
      "Delete this thread?"
    )
  ){
    return;
  }

  state.board=
    state.board.filter(
      x=&gt;x.id!==id
    );

  save();
  renderView();
}

