}

function adminView(el){
  if(!isAdmin()){
    go("home");
    return;
  }

  const s=season();

  el.innerHTML=`

    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;h1&gt;Admin&lt;/h1&gt;

        &lt;p class="sub"&gt;
          League settings and overrides
        &lt;/p&gt;

      &lt;/div&gt;

      &lt;button
        class="btn"
        onclick="newSeason()"
      &gt;
        New Season
      &lt;/button&gt;

    &lt;/div&gt;

    &lt;div class="tabs"&gt;

      &lt;button class="active"&gt;
        Season
      &lt;/button&gt;

      &lt;button
        onclick="adminPlayers()"
      &gt;
        Players
      &lt;/button&gt;

    &lt;/div&gt;

    &lt;div class="card"&gt;

      &lt;h2&gt;
        ${esc(s.name)}
      &lt;/h2&gt;

      &lt;div class="grid grid2"&gt;

        ${fieldSel(
          "League format",
          "af",
          s.format,
          [
            [
              "individual",
              "Individual / rotating partners"
            ],
            [
              "fixed",
              "Fixed teams"
            ]
          ]
        )}

        ${fieldNum(
          "Games per pairing per week",
          "ag",
          s.gamesPerPair,
          1,
          10
        )}

        ${fieldNum(
          "Play to",
          "at",
          s.target,
          1,
          99
        )}

        ${fieldNum(
          "Win by",
          "awb",
          s.winBy,
          1,
          10
        )}

        ${fieldNum(
          "RSVP deadline (days before)",
          "ard",
          s.rsvpDays,
          0,
          14
        )}

        ${fieldNum(
          "Estimated minutes per game",
          "agm",
          state.settings.gameMinutes,
          5,
          120
        )}

        ${fieldNum(
          "Playoff qualifiers",
          "apq",
          s.playoffQualifiers,
          2,
          32
        )}

        &lt;div class="field"&gt;

          &lt;label&gt;
            Playoffs
          &lt;/label&gt;

          &lt;select id="apo"&gt;

            &lt;option
              value="1"
              ${s.playoffs?"selected":""}
            &gt;
              On
            &lt;/option&gt;

            &lt;option
              value="0"
              ${!s.playoffs?"selected":""}
            &gt;
              Off
            &lt;/option&gt;

          &lt;/select&gt;

        &lt;/div&gt;

      &lt;/div&gt;

      &lt;br&gt;

      &lt;button
        class="btn"
        onclick="saveAdminSettings()"
      &gt;
        Save Settings
      &lt;/button&gt;

    &lt;/div&gt;

    &lt;div class="card"&gt;

      &lt;h3&gt;
        Prototype data
      &lt;/h3&gt;

      &lt;p class="tiny muted"&gt;
        Login is secure through Supabase.
        League data is still stored locally
        during this testing stage.
      &lt;/p&gt;

    &lt;/div&gt;
  `;
}

function fieldSel(l,id,v,ops){
  return`

    &lt;div class="field"&gt;

      &lt;label&gt;
        ${l}
      &lt;/label&gt;

      &lt;select id="${id}"&gt;

        ${
          ops.map(o=&gt;`

            &lt;option
              value="${o[0]}"
              ${v===o[0]?"selected":""}
            &gt;
              ${o[1]}
            &lt;/option&gt;

          `).join("")
        }

      &lt;/select&gt;

    &lt;/div&gt;
  `;
}

function fieldNum(
  l,
  id,
  v,
  min,
  max
){
  return`

    &lt;div class="field"&gt;

      &lt;label&gt;
        ${l}
      &lt;/label&gt;

      &lt;input
        id="${id}"
        type="number"
        min="${min}"
        max="${max}"
        value="${v}"
      &gt;

    &lt;/div&gt;
  `;
}

function saveAdminSettings(){
  const s=season();

  s.format=
    $("#af").value;

  s.gamesPerPair=
    +$("#ag").value;

  s.target=
    +$("#at").value;

  s.winBy=
    +$("#awb").value;

  s.rsvpDays=
    +$("#ard").value;

  s.playoffs=
    $("#apo").value==="1";

  s.playoffQualifiers=
    +$("#apq").value;

  state.settings.gameMinutes=
    +$("#agm").value;

  save();

  log(
    "Updated league settings"
  );

  renderView();
  toast("Saved");
}

function adminPlayers(){
  const s=season();

  $("#main").innerHTML=`

    &lt;div class="row between"&gt;

      &lt;div&gt;

        &lt;h1&gt;Players&lt;/h1&gt;

        &lt;p class="sub"&gt;
          Invite-only roster
        &lt;/p&gt;

      &lt;/div&gt;

      &lt;div class="row"&gt;

        &lt;button
          class="btn ghost"
          onclick="go('admin')"
        &gt;
          Back
        &lt;/button&gt;

        &lt;button
          class="btn"
          onclick="invitePlayer()"
        &gt;
          Invite Player
        &lt;/button&gt;

      &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class="card"&gt;

      ${
        state.players.map(p=&gt;`

          &lt;div class="item row between"&gt;

            &lt;div&gt;

              &lt;b&gt;
                ${esc(p.name)}
              &lt;/b&gt;

              &lt;div class="tiny muted"&gt;
                ${esc(p.email||"")}
                •
                ${p.role}
              &lt;/div&gt;

            &lt;/div&gt;

            &lt;div class="row"&gt;

              &lt;button
                class="btn ghost sm"
                onclick="toggleSeasonPlayer('${p.id}')"
              &gt;
                ${
                  s.players.includes(p.id)
                  ?"Remove from season"
                  :"Add to season"
                }
              &lt;/button&gt;

              ${
                p.id!==me().id
                ?`

                  &lt;button
                    class="btn ghost sm"
                    onclick="toggleAdmin('${p.id}')"
                  &gt;
                    ${
                      p.role==="admin"
                      ?"Make Player"
                      :"Make Admin"
                    }
                  &lt;/button&gt;

                `
                :""
              }

            &lt;/div&gt;

          &lt;/div&gt;

        `).join("")
      }

    &lt;/div&gt;
  `;
}

function invitePlayer(){
  modal(`

    &lt;h2&gt;
      Invite Player
    &lt;/h2&gt;

    &lt;div class="stack"&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;
          Name
        &lt;/label&gt;

        &lt;input id="pn"&gt;

      &lt;/div&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;
          Email
        &lt;/label&gt;

        &lt;input
          id="pe"
          type="email"
        &gt;

      &lt;/div&gt;

      &lt;label&gt;

        &lt;input
          id="ps"
          type="checkbox"
        &gt;

        Substitute pool

      &lt;/label&gt;

      &lt;button
        class="btn"
        onclick="saveInvite()"
      &gt;
        Add Test Player
      &lt;/button&gt;

    &lt;/div&gt;
  `);
}

function saveInvite(){
  const n=
    $("#pn").value.trim();

  const e=
    $("#pe").value.trim();

  if(!n){
    toast("Name required");
    return;
  }

  const p={
    id:uid("p"),
    name:n,
    email:e,
    role:"member",
    active:true,
    sub:$("#ps").checked
  };

  state.players.push(p);

  season().players.push(p.id);

  save();
  closeModal();
  adminPlayers();

  toast(
    "Test player added"
  );
}

function toggleSeasonPlayer(id){
  const s=season();

  s.players=
    s.players.includes(id)
    ?s.players.filter(x=&gt;x!==id)
    :[...s.players,id];

  save();
  adminPlayers();
}

function toggleAdmin(id){
  const p=player(id);

  p.role=
    p.role==="admin"
    ?"member"
    :"admin";

  save();
  adminPlayers();
}

function newSeason(){
  modal(`

    &lt;h2&gt;
      New League / Season
    &lt;/h2&gt;

    &lt;div class="stack"&gt;

      &lt;div class="field"&gt;

        &lt;label&gt;
          Name
        &lt;/label&gt;

        &lt;input
          id="sn"
          placeholder="Winter 2027"
        &gt;

      &lt;/div&gt;

      ${fieldSel(
        "Format",
        "sf",
        "individual",
        [
          [
            "individual",
            "Individual / rotating partners"
          ],
          [
            "fixed",
            "Fixed teams"
          ]
        ]
      )}

      &lt;button
        class="btn"
        onclick="saveSeason()"
      &gt;
        Create
      &lt;/button&gt;

    &lt;/div&gt;
  `);
}

function saveSeason(){
  const n=
    $("#sn").value.trim();

  if(!n)return;

  const s={
    id:uid("s"),
    name:n,
    format:$("#sf").value,
    status:"active",
    gameDay:today(),
    startTime:"18:00",
    gamesPerPair:2,
    target:11,
    winBy:2,
    bestOf:1,
    rsvpDays:2,
    playoffs:true,
    playoffQualifiers:4,
    players:
      state.players
      .filter(p=&gt;p.active)
      .map(p=&gt;p.id),
    weeks:[]
  };

  state.seasons.push(s);
  state.activeSeason=s.id;

  save();
  closeModal();
  render();
}

function modal(content){
  $("#modalRoot").innerHTML=`

    &lt;div
      class="modalback"
      onclick="
        if(event.target===this)
        closeModal()
      "
    &gt;

      &lt;div class="modal"&gt;

        &lt;div class="row between"&gt;

          &lt;span&gt;&lt;/span&gt;

          &lt;button
            class="btn ghost sm"
            onclick="closeModal()"
          &gt;
            Close
          &lt;/button&gt;

        &lt;/div&gt;

        ${content}

      &lt;/div&gt;

    &lt;/div&gt;
  `;
}

function closeModal(){
  $("#modalRoot").innerHTML="";
}

boot();
&lt;/script&gt;

&lt;/body&gt;
&lt;/html&gt;
